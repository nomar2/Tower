# Copy this file to keystore.properties (same directory) and fill it in.
# keystore.properties is gitignored and must never be committed.
#
# Create the keystore once (keep the .jks file and these passwords backed up
# somewhere safe - losing them means you can never ship an update to the same app):
#
#   keytool -genkeypair -v \
#     -keystore tower-release.jks -alias tower \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Then point storeFile at that file.

storeFile=C:/keys/tower-release.jks
storePassword=CHANGE_ME
keyAlias=tower
keyPassword=CHANGE_ME
